{
  "name": "my-novel-reader",
  "version": "9.3.3",
  "buildDate": "2026-07-13",
  "type": "module",
  "description": "小说阅读脚本 - 统一阅读样式，智能内容检测，自动翻页",
  "scripts": {
    "build": "vite build",
    "check:size": "node tools/checkBundleSize.mjs",
    "dev": "vite build --watch",
    "preview": "vite preview",
    "profile:performance": "npm run build && playwright test tests/e2e/performance-profile.spec.ts --workers=1",
    "profile:performance:real": "MNR_PROFILE_REAL=1 npm run profile:performance",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run e2e:smoke",
    "e2e:warmup": "playwright test tests/e2e/cloudflare-warmup.spec.ts --headed --workers=1",
    "e2e:smoke": "npm run build && playwright test tests/e2e/real-site-smoke.spec.ts --workers=1",
    "e2e:smoke:headed": "npm run build && playwright test tests/e2e/real-site-smoke.spec.ts --headed --workers=1",
    "e2e:smoke:cdp": "npm run build && playwright test tests/e2e/real-chrome-cdp-smoke.spec.ts --workers=1",
    "e2e:local": "npm run build && npm run check:size && npm run e2e:local:run",
    "e2e:local:run": "playwright test tests/e2e/local-fixture-smoke.spec.ts --workers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "validate": "npm run lint:strict && npm run typecheck && npm run typecheck:tests && npm run test:coverage && npm run e2e:local",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonEX/MyNovelReader.git"
  },
  "keywords": [],
  "author": "ywzhaiqi and contributors",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/JasonEX/MyNovelReader/issues"
  },
  "homepage": "https://github.com/JasonEX/MyNovelReader#readme",
  "dependencies": {
    "chinese-conv": "^4.0.0",
    "dompurify": "^3.1.6",
    "opencc-js": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "pinia": "^3.0.4",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-monkey": "^8.0.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-eslint-parser": "^10.4.1"
  }
}
