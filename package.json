{
  "name": "my-novel-reader",
  "version": "9.0.1",
  "type": "module",
  "description": "小说阅读脚本 - 统一阅读样式，智能内容检测，自动翻页",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run e2e:smoke",
    "e2e:warmup": "playwright test tests/e2e/cloudflare-warmup.spec.ts --headed --workers=1",
    "e2e:smoke": "npm run build && playwright test tests/e2e/real-site-smoke.spec.ts --workers=1",
    "e2e:smoke:headed": "npm run build && playwright test tests/e2e/real-site-smoke.spec.ts --headed --workers=1",
    "e2e:smoke:cdp": "npm run build && playwright test tests/e2e/real-chrome-cdp-smoke.spec.ts --workers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsc --noEmit && eslint . && vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ywzhaiqi/userscript.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ywzhaiqi/userscript/issues"
  },
  "homepage": "https://github.com/ywzhaiqi/userscript#readme",
  "dependencies": {
    "chinese-conv": "^3.2.2",
    "dompurify": "^3.1.6",
    "opencc-js": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "pinia": "^2.3.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.2.0",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-monkey": "^7.1.8",
    "vitest": "^3.2.0",
    "vue": "^3.4.0",
    "vue-eslint-parser": "^9.0.0"
  }
}
